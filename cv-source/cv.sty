% Custom CV Style — Professional with visual structure
% Designed for research economist / tech industry applications

% ---- Fonts ----

\input{glyphtounicode}
\pdfgentounicode=1
\usepackage[T1]{fontenc}
\usepackage{sourceserifpro}
\DeclareRobustCommand{\sbseries}{\fontseries{sb}\selectfont}
\DeclareTextFontCommand{\textsb}{\sbseries}
\usepackage{sourcecodepro}
\usepackage[hyphens]{url}

% ---- Math fonts ----

\usepackage{MnSymbol}
\usepackage[cal=euler,bb=fourier]{mathalpha}
\usepackage[italic,eulergreek,nolessnomore,noparenthesis,noplusnominus,noequal,nohbar]{mathastext}

% ---- Page layout ----

\usepackage{geometry}
\geometry{top=0.55in, bottom=0.6in, left=0.9in, right=0.9in, footskip=0.5in}

% ---- Spacing ----

\usepackage{setspace}
\setstretch{1.0}
\usepackage{microtype}

% ---- Colors ----

\usepackage[x11names]{xcolor}
\definecolor{accent}{HTML}{1B3A5C}     % dark navy
\definecolor{lightaccent}{HTML}{3D6B99} % lighter navy for links
\definecolor{rulecolor}{HTML}{B0C4D8}  % soft blue-gray for rules
\definecolor{datecolor}{HTML}{555555}   % dark gray for dates
\definecolor{desccolor}{HTML}{333333}   % slightly lighter for descriptions

% ---- Header and footer ----

\usepackage{fancyhdr}
\pagestyle{fancy}
\renewcommand{\headrule}{}
\fancyhf{}
\fancyfoot[C]{\footnotesize\textcolor{datecolor}{\thepage}}

% ---- Section headings ----

\usepackage{titlesec}

% Name heading: centered, large
\titleformat{\section}[block]{\centering\fontsize{24}{28}\selectfont\scshape\color{accent}}{}{0pt}{}

% Section blocks: left-aligned, uppercase small caps with rule
\titleformat{\subsection}[block]{\vspace{2pt}\large\sbseries\scshape\color{accent}}{}{0pt}{}[\vspace{1pt}\textcolor{rulecolor}{\rule{\textwidth}{0.8pt}}\vspace{2pt}]
\titlespacing*{\subsection}{0pt}{8pt}{5pt}

% ---- Lists ----

\usepackage{enumitem}
\usepackage[leftmargin=1.5em]{etaremune}

% Main item list (employment, education)
\setlist[itemize,1]{leftmargin=0em, label={}, itemsep=6pt, topsep=3pt, parsep=1pt}

% Sub-item list (employment bullets)
\setlist[itemize,2]{leftmargin=1.5em, label=\textcolor{rulecolor}{\small$\bullet$}, itemsep=2pt, topsep=3pt, parsep=0pt}

% Numbered lists (publications)
\setlist[enumerate,1]{leftmargin=1.5em}
\renewcommand{\labelenumi}{\color{datecolor}\theenumi.}

% ---- Hyperlinks ----

\usepackage[pdftex, hypertexnames=false, pdfpagemode=UseNone, pdfdisplaydoctitle=true]{hyperref}
\hypersetup{colorlinks=true, linkcolor=lightaccent, urlcolor=lightaccent, citecolor=lightaccent}

% ---- Custom commands ----

% CV title (name)
\newcommand{\name}[1]{\section*{#1}}

% Contact info line
\newcommand{\contact}[1]{\begin{center}\textcolor{datecolor}{\small #1}\end{center}\vspace{-4pt}}

% Inline separator
\newcommand{\sep}{{\color{rulecolor}\;\textbullet\;\,}}

% Block heading
\newcommand{\block}[1]{\subsection*{#1}}

% Coauthor
\newcommand{\with}[1]{\,(with #1)}

% Date styling
\newcommand{\dates}[1]{\textcolor{datecolor}{#1}}

% Description text (for paper blurbs)
\newcommand{\desc}[1]{{\small\textcolor{desccolor}{#1}}}

% Entry with date right-aligned: \entry{Left content}{Date}
\newcommand{\entry}[2]{#1\hfill\dates{#2}}

% Gray footer (kept for compatibility)
\newcommand{\grayfoot}[2]{\fancyfoot[#1]{\footnotesize\textcolor{datecolor}{#2}}}

% Horizontal thin rule
\newcommand{\hsep}{\noindent\textcolor{rulecolor}{\rule{\textwidth}{0.5pt}}}
